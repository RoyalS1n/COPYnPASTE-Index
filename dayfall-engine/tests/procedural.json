[
 {"tool": "catalog", "args": {}, "expect": {"contains": {"/primitives": {"type": "tree"}}}},
 {"tool": "batch_begin", "args": {"title": "procedural trees"}, "expect": {"equals": {"/batch/title": "procedural trees"}}},
 {"tool": "object_add", "args": {"objects": [
   {"id": "pg_oak", "mesh": {"type": "tree", "species": "oak", "seed": 3}, "position": [40, -40]},
   {"id": "pg_birch", "mesh": {"type": "tree", "species": "birch", "seed": 3}, "position": [50, -40]},
   {"id": "pg_pine", "mesh": {"type": "tree", "species": "pine", "height": 18, "seed": 2}, "position": [60, -40]},
   {"id": "pg_bush", "mesh": {"type": "tree", "species": "bush", "seed": 2}, "position": [70, -40]},
   {"id": "pg_dead", "mesh": {"type": "tree", "species": "dead", "seed": 2}, "position": [80, -40]}]},
  "expect": {"at_least": {"/added": 5, "/added/0/size_m/2": 9.0, "/added/0/size_m/0": 6.0, "/added/2/size_m/2": 17.5, "/added/3/size_m/2": 1.8},
             "at_most": {"/added/0/size_m/2": 12.0, "/added/0/size_m/0": 11.0, "/added/1/size_m/0": 7.0, "/added/3/size_m/2": 3.0}}},
 {"tool": "object_add", "args": {"id": "pg_bad", "mesh": {"type": "tree", "species": "palm"}, "position": [0, -40]},
  "expect": {"error_contains": "unknown tree species 'palm'"}},
 {"tool": "object_add", "args": {"id": "pg_bad", "mesh": {"type": "tree", "height": 200}, "position": [0, -40]},
  "expect": {"error_contains": "height must be between 0.5 and 80"}},
 {"tool": "object_add", "args": {"id": "pg_bad", "mesh": {"type": "tree", "height": "tall"}, "position": [0, -40]},
  "expect": {"error_contains": "tree height must be a number"}},
 {"tool": "world_get", "args": {"section": "objects", "id": "pg_oak"},
  "expect": {"equals": {"/item/mesh/species": "oak"}, "at_least": {"/item/resolved/size_m/2": 9.0}}},
 {"tool": "scatter_set", "args": {"id": "pg_grove", "meshes": [{"mesh": {"type": "tree", "species": "pine", "seed": 1}}, {"mesh": {"type": "tree", "species": "birch", "seed": 4}}],
   "area": {"rect": {"center": [-80, -80], "size": [40, 40]}}, "density_per_100m2": 1.0, "footprint_m": 2.5,
   "companions": [{"meshes": [{"mesh": "pebble_a"}, {"mesh": "pebble_b"}], "count": [1, 3], "distance_m": [0.8, 2.0]}]},
  "expect": {"at_least": {"/instances": 6}}},
 {"tool": "scatter_set", "args": {"id": "pg_rocks", "mesh": "rock_b", "area": {"rect": {"center": [-80, -80], "size": [40, 40]}},
   "density_per_100m2": 2.0, "avoid_rules": ["pg_grove"], "avoid_rules_m": 0.5}, "expect": {"at_least": {"/instances": 1}}},
 {"tool": "scatter_set", "args": {"id": "pg_bad", "mesh": "rock_b", "area": {"rect": {"center": [-80, -80], "size": [10, 10]}},
   "companions": [{"mesh": "pebble_a", "count": [3, 1]}]}, "expect": {"error_contains": "companion count must be [min, max]"}},
 {"tool": "scatter_set", "args": {"id": "pg_bad", "mesh": "rock_b", "area": {"rect": {"center": [-80, -80], "size": [10, 10]}},
   "avoid_rules": "pg_grove"}, "expect": {"error_contains": "avoid_rules must be an array"}},
 {"tool": "capture", "args": {"views": [{"position": [-80, -110, 12], "target": [-80, -80, 3]}], "width": 320, "height": 180, "save": false},
  "expect": {"at_least": {"/views": 1}}},
 {"tool": "batch_end", "args": {"save": false, "notes": "procedural trees"}, "expect": {"equals": {"/saved": false}}},

 {"tool": "batch_begin", "args": {"title": "erosion and rivers"}},
 {"tool": "ground_query", "args": {"points": [[-100, -100]]}, "expect": {"equals": {"/points/0/terrain_height": 4.3}}},
 {"tool": "terrain_erode", "args": {"area": {"rect": {"center": [0, 60], "size": [120, 120]}, "falloff": 10}, "seed": 1},
  "expect": {"equals": {"/mode": "hydraulic"}, "at_least": {"/samples_changed": 5000, "/volume_moved_m3": 1000, "/max_cut_m": 0.5},
             "at_most": {"/max_cut_m": 8.0, "/max_fill_m": 8.0}}},
 {"tool": "ground_query", "args": {"points": [[-100, -100]]}, "expect": {"equals": {"/points/0/terrain_height": 4.3}}},
 {"tool": "undo", "args": {}},
 {"tool": "terrain_erode", "args": {"mode": "thermal", "talus_deg": 15, "passes": 10, "area": {"circle": {"center": [0, 60], "radius": 40}}},
  "expect": {"equals": {"/mode": "thermal", "/passes": 10}, "at_least": {"/samples_changed": 100}}},
 {"tool": "terrain_erode", "args": {"droplets_per_m2": 0}, "expect": {"error_contains": "droplets_per_m2 must be above 0"}},
 {"tool": "terrain_erode", "args": {"mode": "glacial"}, "expect": {"error_contains": "mode must be hydraulic or thermal"}},
 {"tool": "terrain_erode", "args": {"seed": "x"}, "expect": {"error_contains": "erode seed must be a number"}},
 {"tool": "terrain_sculpt", "args": {"op": "terrace", "step_m": 2, "sharpness": 1, "area": {"rect": {"center": [-60, 60], "size": [20, 20]}}},
  "expect": {"equals": {"/results/0/op": "terrace"}, "at_least": {"/results/0/samples_changed": 100}}},
 {"tool": "terrain_sculpt", "args": {"op": "redistribute", "exponent": 2, "area": {"circle": {"center": [0, 60], "radius": 30}}},
  "expect": {"equals": {"/results/0/op": "redistribute"}, "at_least": {"/results/0/samples_changed": 100}}},
 {"tool": "terrain_sculpt", "args": {"op": "terrace", "step_m": 0, "area": {"rect": {"center": [-60, 60], "size": [20, 20]}}},
  "expect": {"error_contains": "terrace step_m must be between"}},
 {"tool": "rivers_generate", "args": {"max_rivers": 2, "min_length_m": 40},
  "expect": {"equals": {"/rivers/0/id": "river_1"}, "at_least": {"/rivers": 1, "/rivers/0/length_m": 40, "/rivers/0/width_m": 2.0,
             "/rivers/0/flow_m_s": 0.1}}},
 {"tool": "world_get", "args": {"section": "water", "id": "river_1"}, "expect": {"equals": {"/item/type": "river"}, "at_least": {"/item/points": 3}}},
 {"tool": "rivers_generate", "args": {"min_length_m": 100000}, "expect": {"error_contains": "no channel long enough"}},
 {"tool": "rivers_generate", "args": {"max_rivers": 1, "id_prefix": ""}, "expect": {"error_contains": "id_prefix must not be empty"}},
 {"tool": "capture", "args": {"views": [{"overview": true}], "width": 320, "height": 180, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "erosion and rivers"}, "expect": {"equals": {"/saved": false}}},

 {"tool": "batch_begin", "args": {"title": "generate with erosion"}},
 {"tool": "terrain_generate", "args": {"preset": "hills", "size_m": 128, "seed": 4, "erosion": 0.8},
  "expect": {"equals": {"/terrain/size_m": 128.0}}},
 {"tool": "terrain_generate", "args": {"preset": "hills", "size_m": 128, "erosion": "lots"}, "expect": {"error_contains": "erosion must be a number"}},
 {"tool": "undo", "args": {}},
 {"tool": "terrain_info", "args": {}, "expect": {"equals": {"/summary/size_m": 256.0}}},
 {"tool": "capture", "args": {"views": [{"overview": true}], "width": 320, "height": 180, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "generate with erosion"}}
]
