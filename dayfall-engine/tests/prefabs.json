[
 {"tool": "batch_begin", "args": {"title": "prefabs test"}},
 {"tool": "object_add", "args": {"objects": [
   {"id": "farm_house", "mesh": {"type": "box", "size": [6, 4, 3], "material": "plaster"}, "position": [20, -30], "tags": ["farm"]},
   {"id": "farm_barrel", "mesh": {"type": "cylinder", "radius": 0.5, "height": 1, "material": "wood"},
    "place": {"next_to": "farm_house", "side": "east"}, "tags": ["farm"]}]},
  "expect": {"equals": {"/added/1/position/0": 23.8}}},
 {"tool": "light_set", "args": {"id": "farm_lamp", "position": [20, -33, 6.5], "color": [1, 0.8, 0.5], "intensity": 8}},
 {"tool": "object_update", "args": {"id": "farm_lamp", "set": {"tags": ["farm"]}}, "expect": {"error_contains": "lights"}},
 {"tool": "doc_patch", "args": {"patch": [{"op": "add", "path": "/lights/0/tags", "value": ["farm"]}]}},
 {"tool": "prefab_save", "args": {"name": "farmstead", "tag": "farm", "origin": [20, -30], "description": "house, barrel, lamp"},
  "expect": {"equals": {"/items": 3, "/origin": [20.0, -30.0]}}},
 {"tool": "prefab_save", "args": {"name": "farmstead", "tag": "farm"}, "expect": {"error_contains": "replace: true"}},
 {"tool": "catalog", "args": {}, "expect": {"equals": {"/prefabs/farmstead/items": 3, "/prefabs/farmstead/source": "map"}}},

 {"tool": "prefab_place", "args": {"name": "farmstead", "position": [-20, -30], "yaw_deg": 90},
  "expect": {"equals": {"/instance": "farmstead_1"}, "at_least": {"/created": 3}, "at_most": {"/created": 3}}},
 {"tool": "world_get", "args": {"id": "farmstead_1_farm_barrel"},
  "expect": {"at_least": {"/item/position/0": -20.01, "/item/position/1": -26.21}, "at_most": {"/item/position/0": -19.99, "/item/position/1": -26.19},
             "equals": {"/item/yaw_deg": 90.0, "/item/prefab/name": "farmstead"}, "contains": {"/item/tags": "farmstead_1"}}},
 {"tool": "world_get", "args": {"id": "farmstead_1_farm_lamp"},
  "expect": {"at_least": {"/item/position/0": -17.01}, "at_most": {"/item/position/0": -16.99}}},
 {"tool": "prefab_place", "args": {"name": "farmstead", "position": [-20, 0]}, "expect": {"equals": {"/instance": "farmstead_2"}}},
 {"tool": "object_update", "args": {"tag": "farmstead_1", "rotate_by_deg": -90, "pivot": [-20, -30]}},
 {"tool": "world_get", "args": {"id": "farmstead_1_farm_barrel"},
  "expect": {"at_least": {"/item/position/0": -16.21}, "at_most": {"/item/position/0": -16.19}, "equals": {"/item/yaw_deg": 0.0}}},
 {"tool": "prefab_save", "args": {"name": "copy", "tag": "farmstead_2"}},
 {"tool": "world_get", "args": {"section": "prefabs"},
  "expect": {"contains": {"/value/copy/objects": {"key": "farm_house"}}}},
 {"tool": "delete", "args": {"tag": "farmstead_1"}, "expect": {"at_least": {"/deleted": 3}}},
 {"tool": "world_get", "args": {"id": "farmstead_1_farm_house"}, "expect": {"error_contains": "no item"}},
 {"tool": "prefab_place", "args": {"name": "nope", "position": [0, 0]}, "expect": {"error_contains": "no prefab"}},
 {"tool": "prefab_save", "args": {"name": "copy", "delete": true}, "expect": {"equals": {"/deleted": "copy"}}},
 {"tool": "capture", "args": {"views": [{"top_down": {"center": [0, -15], "size_m": 70}}], "width": 320, "height": 180, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "prefabs test"}}
]
