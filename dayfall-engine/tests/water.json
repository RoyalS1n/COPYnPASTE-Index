[
 {"tool": "batch_begin", "args": {"title": "water test"}},
 {"tool": "water_set", "args": {"id": "pond", "area": {"circle": {"center": [-30, -30], "radius": 10}, "falloff": 5}, "carve_m": 1.6},
  "expect": {"equals": {"/type": "lake", "/area_m2": 314}, "at_least": {"/level_m": 3.5}, "at_most": {"/level_m": 4.4}}},
 {"tool": "ground_query", "args": {"points": [[-30, -30], [-30, -45]]},
  "expect": {"at_least": {"/points/0/water_depth": 1.4, "/points/0/wet": 0.9}, "at_most": {"/points/1/wet": 0.1}}},
 {"tool": "water_set", "args": {"id": "brook", "points": [[-6, 70], [-20, 58], [-35, 40], [-45, 15], [-48, -12]], "width_m": 4, "depth_m": 1.0},
  "expect": {"equals": {"/type": "river"}, "at_least": {"/surface_m/0": 11.0, "/length_m": 90, "/flow_m_s": 0.35}, "at_most": {"/surface_m/1": 5.0}}},
 {"tool": "ground_query", "args": {"points": [[-35, 40]]}, "expect": {"at_least": {"/points/0/water_depth": 0.4}}},
 {"tool": "world_get", "args": {"section": "water"}, "expect": {"equals": {"/total_matching": 2}}},
 {"tool": "material_set", "args": {"name": "pond_water", "definition": {"model": "water", "absorption_rgb": [0.5, 0.1, 0.12],
   "scattering_rgb": [0.02, 0.04, 0.03], "foam": 0.3, "foam_width_m": 0.2, "fetch_m": 40, "caustics": 1.0, "reflections": true,
   "shore_fade_m": 0.4, "wave_scale": 1.2, "roughness": 0.03}}, "expect": {"equals": {"/material": "pond_water", "/definition/fetch_m": 40}}},
 {"tool": "material_set", "args": {"name": "bad_water", "definition": {"model": "water", "absorption_rgb": [1, 2]}},
  "expect": {"error_contains": "absorption_rgb must be [r, g, b]"}},
 {"tool": "material_set", "args": {"name": "bad_water", "definition": {"model": "water", "fetch_m": "far"}},
  "expect": {"error_contains": "fetch_m must be a number"}},
 {"tool": "material_set", "args": {"name": "bad_water", "definition": {"model": "water", "reflections": 1}},
  "expect": {"error_contains": "reflections must be true or false"}},
 {"tool": "water_set", "args": {"id": "pond", "area": {"circle": {"center": [-30, -30], "radius": 10}, "falloff": 5}, "carve_m": 1.6,
  "material": "pond_water"}, "expect": {"equals": {"/type": "lake"}}},
 {"tool": "world_get", "args": {"section": "water", "id": "pond"}, "expect": {"equals": {"/item/material": "pond_water"}}},
 {"tool": "water_set", "args": {"id": "bad1", "type": "lake"}, "expect": {"error_contains": "needs an area"}},
 {"tool": "water_set", "args": {"id": "bad2", "points": [[0, 0]]}, "expect": {"error_contains": "at least 2"}},
 {"tool": "water_set", "args": {"id": "bad3", "type": "sea", "area": "all"}, "expect": {"error_contains": "lake or river"}},
 {"tool": "water_set", "args": {"id": "bad4", "area": {"circle": {"center": [0, 0], "radius": 5}}, "level_m": "high"},
  "expect": {"error_contains": "number or"}},
 {"tool": "water_set", "args": {"id": "loop", "area": {"circle": {"center": [0, 0], "radius": 5}}}, "expect": {"error_contains": "belongs to paths"}},
 {"tool": "find_space", "args": {"size": [6, 6], "near": [-30, -30], "radius_m": 9, "max_height_diff_m": 5, "max_slope_deg": 60},
  "expect": {"at_least": {"/rejected/water": 1}, "at_most": {"/sites": 0}}},
 {"tool": "walk_test", "args": {"points": [[-30, -46], [-30, -30]], "captures": false},
  "expect": {"contains": {"/events": {"type": "water"}}}},
 {"tool": "capture", "args": {"views": [{"orbit": {"target": [-30, -30, 3], "distance_m": 30, "yaw_deg": 210, "pitch_deg": 28}}],
                              "width": 320, "height": 180, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "a lake and a river"}},

 {"tool": "batch_begin", "args": {"title": "water undo and delete"}},
 {"tool": "area_set", "args": {"name": "tarn", "area": {"circle": {"center": [30, -40], "radius": 6}, "falloff": 3}}},
 {"tool": "water_set", "args": {"id": "tarn_water", "area": "tarn", "carve_m": 1.0}, "expect": {"equals": {"/area_m2": 113}}},
 {"tool": "world_get", "args": {"section": "water", "ids": ["tarn_water"]}, "expect": {"equals": {"/items/0/area": "tarn"}}},
 {"tool": "undo", "args": {}},
 {"tool": "world_get", "args": {"section": "water"}, "expect": {"equals": {"/total_matching": 2}}},
 {"tool": "delete", "args": {"ids": ["pond"]}, "expect": {"equals": {"/deleted": ["pond"]}}},
 {"tool": "ground_query", "args": {"points": [[-30, -30]]}, "expect": {"at_least": {"/points/0/terrain_height": 3.3}}},
 {"tool": "capture", "args": {"views": [{"overview": true}], "width": 320, "height": 180, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "undo and delete"}}
]
