[
 {"tool": "batch_begin", "args": {"title": "world tools test"}},
 {"tool": "area_set", "args": {"name": "yard", "area": {"rect": {"center": [-1, -8], "size": [24, 16]}}},
  "expect": {"equals": {"/area_m2": 384}}},
 {"tool": "find_space", "args": {"size": [6, 4], "area": "yard", "count": 2},
  "expect": {"at_least": {"/sites": 1}}},
 {"tool": "find_space", "args": {"size": [6, 4], "area": "nowhere"}, "expect": {"error_contains": "no named area"}},

 {"tool": "object_add", "args": {"id": "wt_shed", "mesh": {"type": "box", "size": [6, 4, 3], "material": "plaster"}, "position": [-1, -8]},
  "expect": {"equals": {"/added/0/max/2": 7.0}}},
 {"tool": "object_add", "args": {"id": "wt_crate", "mesh": {"type": "box", "size": [1, 1, 1], "material": "wood"}, "place": {"on": "wt_shed"}},
  "expect": {"equals": {"/added/0/min/2": 7.0}}},
 {"tool": "object_add", "args": {"id": "wt_barrel", "mesh": {"type": "cylinder", "radius": 0.5, "height": 1, "material": "wood"},
                                 "place": {"next_to": "wt_shed", "side": "east", "gap_m": 0.5}},
  "expect": {"equals": {"/added/0/position/0": 3.0}}},
 {"tool": "object_add", "args": {"id": "wt_sign", "mesh": {"type": "box", "size": [0.2, 1, 1], "material": "wood"},
                                 "place": {"relative_to": "wt_shed", "offset": [0, -3]}},
  "expect": {"equals": {"/added/0/position/1": -11.0}}},
 {"tool": "object_update", "args": {"ids": ["wt_shed", "wt_crate", "wt_barrel", "wt_sign"], "rotate_by_deg": 90, "pivot": "center"}},
 {"tool": "world_get", "args": {"id": "wt_barrel"},
  "expect": {"equals": {"/item/position": [-0.75, -5.75], "/item/yaw_deg": 90.0}}},
 {"tool": "object_duplicate", "args": {"ids": ["wt_barrel"], "count": 3, "offset": [1.5, 0]},
  "expect": {"at_least": {"/created": 3}}},
 {"tool": "object_duplicate", "args": {"ids": ["wt_sign"], "count": 1, "rotate_by_deg": 180, "pivot": [-0.75, -9.75], "id_prefix": "wt_sign_back"},
  "expect": {"at_least": {"/created": 1}}},
 {"tool": "world_get", "args": {"id": "wt_sign_back_1"}, "expect": {"equals": {"/item/position": [-3.75, -9.75], "/item/yaw_deg": -90.0}}},
 {"tool": "world_check", "args": {"area": "yard"},
  "expect": {"at_most": {"/counts/error": 0, "/counts/warning": 0}}},

 {"tool": "object_add", "args": {"objects": [
   {"id": "wt_float", "mesh": {"type": "box", "size": [1, 1, 1], "material": "brick"}, "position": [-6, -2, 12]},
   {"id": "wt_dup_a", "mesh": {"type": "box", "size": [1, 2, 1], "material": "brick"}, "position": [-8, -14]},
   {"id": "wt_dup_b", "mesh": {"type": "box", "size": [1, 2, 1], "material": "brick"}, "position": [-8, -14]},
   {"id": "wt_on_path", "mesh": {"type": "box", "size": [2, 2, 2], "material": "brick"}, "position": [22, -18]},
   {"id": "wt_block", "mesh": {"type": "box", "size": [4, 4, 4], "material": "brick"}, "position": [-14, -14]},
   {"id": "wt_inner", "mesh": {"type": "box", "size": [1, 1, 1], "material": "brick"}, "position": [-14, -14], "offset_z": 1.5}]}},
 {"tool": "entity_add", "args": {"id": "wt_gem", "type": "collectible", "position": [-14, -14, 6]}},
 {"tool": "world_check", "args": {},
  "expect": {"contains": {"/issues": {"kind": "floating", "ids": "wt_float"}}}},
 {"tool": "world_check", "args": {"min_severity": "error"},
  "expect": {"contains": {"/issues": {"kind": "duplicate", "ids": "wt_dup_b"}}}},
 {"tool": "world_check", "args": {},
  "expect": {"contains": {"/issues": {"kind": "blocks_path", "ids": "loop"}}}},
 {"tool": "world_check", "args": {},
  "expect": {"contains": {"/issues": {"kind": "entity_inside_object", "ids": "wt_block"}}}},
 {"tool": "world_check", "args": {},
  "expect": {"contains": {"/issues": {"kind": "embedded", "ids": "wt_inner"}}}},

 {"tool": "scatter_set", "args": {"id": "wt_grass", "mesh": "grass_clump_a", "area": "yard", "density_per_100m2": 4}},
 {"tool": "world_get", "args": {"section": "scatter", "ids": ["wt_grass"]}, "expect": {"equals": {"/items/0/area": "yard"}}},
 {"tool": "area_set", "args": {"name": "yard", "delete": true}, "expect": {"error_contains": "uses this area"}},
 {"tool": "world_diff", "args": {},
  "expect": {"contains": {"/sections/objects/added": "wt_shed", "/settings_changed": "areas"}, "at_least": {"/items_changed": 10}}},
 {"tool": "delete", "args": {"section": "objects", "area": "yard"}, "expect": {"at_least": {"/deleted": 6}}},
 {"tool": "editor_select", "args": {"ids": ["ramp"], "frame": true}, "expect": {"equals": {"/selected": ["ramp"]}}},
 {"tool": "editor_state", "args": {}, "expect": {"contains": {"/selection": {"id": "ramp", "section": "objects"}}, "at_least": {"/selection/0/box/size_m/2": 1.9}}},
 {"tool": "editor_select", "args": {"ids": ["no_such_thing"]}, "expect": {"error_contains": "no item"}},
 {"tool": "editor_select", "args": {"clear": true, "click": [0.5, 0.5]}, "expect": {"equals": {"/selected": ["ramp"]}}},
 {"tool": "capture", "args": {"views": [{"editor": true}, {"top_down": {"center": [-1, -8], "size_m": 40}}], "selection": true,
                              "width": 320, "height": 180, "save": false}},
 {"tool": "editor_select", "args": {"clear": true}, "expect": {"equals": {"/selected": []}}},
 {"tool": "batch_end", "args": {"save": false, "notes": "world tools test"}}
]
