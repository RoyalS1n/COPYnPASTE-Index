[
 {"tool": "batch_begin", "args": {"title": "regressions"}, "expect": {"equals": {"/batch/title": "regressions"}}},
 {"tool": "entity_add", "args": {"type": "goal", "id": "rg_goal", "position": [0, -14], "radius_m": "big"},
  "expect": {"error_contains": "the edit was undone"}},
 {"tool": "world_get", "args": {"section": "entities", "near": {"position": [0, -14], "radius_m": 0.5}},
  "expect": {"equals": {"/total_matching": 0}}},
 {"tool": "object_add", "args": {"id": "rg_after", "mesh": {"type": "box"}, "position": [4, -14]},
  "expect": {"contains": {"/added": {"id": "rg_after"}}, "equals": {"/batch/edits": 1}}},
 {"tool": "camera_set", "args": {"name": "rg_cam", "position": [0, -30, 10], "target": [0, 0, 4], "vfov_deg": 40}},
 {"tool": "capture", "args": {"views": [{"camera": "rg_cam"}], "width": 256, "height": 144, "save": false},
  "expect": {"equals": {"/views/0/label": "rg_cam"}}},
 {"tool": "camera_set", "args": {"name": "rg_cam", "delete": true}},
 {"tool": "capture", "args": {"views": [{"camera": "rg_cam"}], "width": 256, "height": 144, "save": false},
  "expect": {"error_contains": "no camera 'rg_cam'"}},
 {"tool": "delete", "args": {"section": "paths", "area": {"circle": {"center": [0, 60], "radius": 30}}},
  "expect": {"contains": {"/deleted": "hill_trail"}}},
 {"tool": "undo", "args": {}},
 {"tool": "world_get", "args": {"section": "paths", "id": "hill_trail"}, "expect": {"equals": {"/item/id": "hill_trail"}}},
 {"tool": "area_set", "args": {"name": "rg_rect", "area": {"rect": {"center": [60, 0], "size": [20, 20]}}},
  "expect": {"equals": {"/bounds": [[50.0, -10.0], [70.0, 10.0]], "/area_m2": 400}}},
 {"tool": "area_set", "args": {"name": "rg_rect", "area": {"rect": {"center": [60, 0], "size": [20, 10], "yaw_deg": 90}}},
  "expect": {"equals": {"/bounds": [[55.0, -10.0], [65.0, 10.0]]}}},
 {"tool": "scatter_set", "args": {"id": "rg_rule", "mesh": "pebble_a", "area": "rg_rect", "density_per_100m2": 10, "clumping": 0},
  "expect": {"at_least": {"/instances": 5}}},
 {"tool": "delete", "args": {"section": "scatter", "area": {"circle": {"center": [60, 0], "radius": 3}}},
  "expect": {"equals": {"/deleted": ["rg_rule"]}}},
 {"tool": "undo", "args": {}},
 {"tool": "capture", "args": {"views": [{"overview": true}], "width": 256, "height": 144, "save": false}},
 {"tool": "area_set", "args": {"name": "rg_rect", "area": {"rect": {"center": [-60, 60], "size": [20, 20]}}},
  "expect": {"equals": {"/followed_by": ["rg_rule"]}, "contains": {"/next": "Not verified yet"}}},
 {"tool": "area_set", "args": {"name": "rg_rect", "delete": true}, "expect": {"error_contains": "'rg_rule' uses this area"}},
 {"tool": "batch_end", "args": {"save": false, "notes": "regressions"}, "expect": {"error_contains": "since the last capture"}},
 {"tool": "capture", "args": {"views": [{"overview": true}], "width": 256, "height": 144, "save": false}},
 {"tool": "batch_end", "args": {"save": false, "notes": "regressions"}, "expect": {"equals": {"/saved": false}}}
]
