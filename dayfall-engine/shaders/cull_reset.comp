#version 460
#extension GL_GOOGLE_include_directive : require
// Writes every draw command of every view with zero instances; cull.comp then
// counts the visible instances into them.
#include "common.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 9) writeonly buffer Cmds { DrawCmd cmds[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint nb = frame.counts.y;
    if (i >= nb * frame.counts.z) return;
    uint view = i / nb, b = i - view * nb;
    Batch bt = batches[b];
    uint first = view == 0u ? bt.mainOffset : shadowBase(view) + bt.shadowOffset;
    cmds[i] = DrawCmd(bt.indexCount, 0u, bt.firstIndex, bt.vertexOffset, first);
}
