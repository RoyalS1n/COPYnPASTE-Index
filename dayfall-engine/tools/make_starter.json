[
 {"tool": "batch_begin", "args": {"title": "starter terrain: rolling hills with a flat plaza"}},
 {"tool": "terrain_generate", "args": {"preset": "hills", "size_m": 256, "spacing_m": 1, "seed": 4, "height_m": 9, "feature_m": 110}},
 {"tool": "terrain_sculpt", "args": {"ops": [
   {"op": "flatten", "height_m": 4.0, "area": {"circle": {"center": [0, 8], "radius": 38}, "falloff": 22}},
   {"op": "raise", "amount_m": 9, "area": {"circle": {"center": [0, 82], "radius": 14}, "falloff": 26}},
   {"op": "smooth", "iterations": 4, "area": {"circle": {"center": [0, 70], "radius": 30}, "falloff": 10}}]}},
 {"tool": "path_set", "args": {"id": "loop", "points": [[0,-28],[22,-18],[30,6],[22,30],[0,40],[-22,30],[-30,6],[-22,-18],[0,-28]], "width_m": 2.8}},
 {"tool": "path_set", "args": {"id": "hill_trail", "points": [[0,40],[3,52],[-2,64],[0,78]], "width_m": 2.4}},
 {"tool": "capture", "args": {"views": [{"top_down": {"center": [0, 20], "size_m": 140}}]}},
 {"tool": "batch_end", "args": {"notes": "flat plaza at 4 m, loop path, trail up the north hill"}},

 {"tool": "batch_begin", "args": {"title": "training course blockout"}},
 {"tool": "object_add", "args": {"objects": [
   {"id": "ramp", "mesh": {"type": "ramp", "size": [4, 10, 2], "material": "blockout"}, "position": [-14, 2]},
   {"id": "ramp_platform", "mesh": {"type": "box", "size": [8, 6, 2], "material": "blockout_dark"}, "position": [-14, 10]},
   {"id": "stairs", "mesh": {"type": "stairs", "size": [3, 4, 1.8], "steps": 10, "material": "blockout"}, "position": [-3, 4]},
   {"id": "stairs_platform", "mesh": {"type": "box", "size": [6, 6, 1.8], "material": "blockout_dark"}, "position": [-3, 9]},
   {"id": "jump_low", "mesh": {"type": "box", "size": [2, 2, 0.6], "material": "blockout"}, "position": [7, 2]},
   {"id": "jump_mid", "mesh": {"type": "box", "size": [2, 2, 1.0], "material": "blockout"}, "position": [7, 5.5]},
   {"id": "jump_high", "mesh": {"type": "box", "size": [2, 2, 1.3], "material": "blockout_dark"}, "position": [7, 9]},
   {"id": "tower_a", "mesh": {"type": "box", "size": [4, 4, 3], "material": "blockout_dark"}, "position": [16, 4]},
   {"id": "tower_b", "mesh": {"type": "box", "size": [4, 4, 3], "material": "blockout_dark"}, "position": [16, 16]},
   {"id": "bridge", "mesh": {"type": "box", "size": [1.6, 8.2, 0.3], "material": "planks"}, "position": [16, 10], "offset_z": 2.7},
   {"id": "tower_ramp", "mesh": {"type": "ramp", "size": [3, 7, 3], "material": "blockout"}, "position": [16, -3.5]},
   {"id": "wall", "mesh": {"type": "box", "size": [14, 1, 3.5], "material": "blockout"}, "position": [0, 24]},
   {"id": "pillar_1", "mesh": {"type": "cylinder", "radius": 0.6, "height": 5, "material": "blockout"}, "position": [-10, 20]},
   {"id": "pillar_2", "mesh": {"type": "cylinder", "radius": 0.6, "height": 5, "material": "blockout"}, "position": [10, 20]},
   {"id": "ball", "mesh": {"type": "sphere", "radius": 1.2, "material": "blockout_dark"}, "position": [-20, -6]},
   {"id": "cone", "mesh": {"type": "cone", "radius": 1.5, "height": 3, "material": "blockout"}, "position": [20, -8]}
 ]}},
 {"tool": "capture", "args": {"views": [{"orbit": {"target": [0, 10], "distance_m": 38, "yaw_deg": -110, "pitch_deg": 28}}, {"player": true}]}},
 {"tool": "batch_end", "args": {"notes": "ramp, stairs, jump blocks 0.6 / 1.0 / 1.3 m, two towers with a bridge, wall, pillars"}},

 {"tool": "batch_begin", "args": {"title": "collectibles and goal"}},
 {"tool": "entity_add", "args": {"entities": [
   {"id": "gem_ramp", "type": "collectible", "position": [-14, 10, 7.1]},
   {"id": "gem_bridge", "type": "collectible", "position": [16, 10, 8.1], "color": [0.4, 0.8, 1.0]},
   {"id": "gem_hill", "type": "collectible", "position": [0, 74], "color": [1.0, 0.45, 0.75]},
   {"id": "hill_goal", "type": "goal", "position": [0, 80], "radius_m": 3, "message": "Course complete!"}
 ]}},
 {"tool": "player_set", "args": {"start": {"position": [0, -20], "yaw_deg": 90}}},
 {"tool": "capture", "args": {"views": [{"player": true}]}},
 {"tool": "batch_end", "args": {"notes": "3 gems (ramp platform, bridge, hill) and a goal on the hill"}},

 {"tool": "batch_begin", "args": {"title": "lighting"}},
 {"tool": "environment_set", "args": {"preset": "serene"}},
 {"tool": "capture", "args": {"views": [{"overview": true}]}},
 {"tool": "batch_end", "args": {"notes": "serene late-afternoon light"}},

 {"tool": "camera_set", "args": {"name": "course", "position": [-30, -18, 14], "target": [2, 10, 5]}},
 {"tool": "camera_set", "args": {"name": "hill", "position": [18, 40, 16], "target": [0, 78, 12]}},
 {"tool": "route_set", "args": {"name": "loop", "path_id": "loop"}},
 {"tool": "route_set", "args": {"name": "to_goal", "include_start": false, "points": [[0, 40], [1, 60], [0, 80]]}},
 {"tool": "walk_test", "args": {"route": "loop"}},
 {"tool": "walk_test", "args": {"route": "to_goal"}},
 {"tool": "play_sim", "args": {"start": {"position": [7, -2], "yaw_deg": 90}, "inputs": [
   {"seconds": 0.45, "move": [0, 1]}, {"seconds": 0.7, "move": [0, 1], "jump": true}, {"seconds": 0.4, "move": [0, 1]},
   {"seconds": 0.7, "move": [0, 1], "jump": true}, {"seconds": 0.4, "move": [0, 1]}, {"seconds": 0.8, "move": [0, 1], "jump": true}, {"seconds": 0.5}], "captures": "end"}},
 {"tool": "save"}
]
